{
  "id": "./",
  "name": "TWA Share Target Regression Test",
  "short_name": "TWA Test",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": ["text/plain", "image/*"]
        }
      ]
    }
  }
}
